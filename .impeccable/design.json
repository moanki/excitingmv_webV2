  "narrative": {
    "northStar": "The Opening Calendar",
    "overview": "This documents an extension of the established Exciting Maldives identity. Preserve the logo, Playfair Display/Inter pairing, public navigation and footer, and existing admin shell. The supplied `A \u00b7 Opening Calendar@2x.png` governs the composition of `/upcoming-resorts`; it does not authorize a redesign of other pages.\n\nThe public extension pairs a dark photographic teal hero with warm paper, serif dates and white image-and-copy cards. The admin extension uses the incumbent shell with restrained framed sheets and ordinary labelled fields. These route-specific treatments are documented separately from the global brand primitives.",
    "keyCharacteristics": [
      "Photographic lagoon hero and restrained gold accents.",
      "Year-grouped vertical timeline with paired image and content cards.",
      "Practical, labelled editing inside the existing admin identity."
    ],
    "rules": [
      {
        "name": "The Scope Rule",
        "body": "Apply opening and calendar-editor tokens only to their documented surfaces; retain existing page-specific palettes elsewhere.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain the incumbent logo, fonts, public navigation/footer and admin identity.",
      "Do follow the supplied opening-calendar reference for this calendar surface.",
      "Do keep full source addresses readable and mobile controls usable.",
      "Do preserve database-backed editable public text."
    ],
    "donts": [
      "Don't apply the calendar palette or composition across unrelated legacy pages.",
      "Don't replace labelled editor fields with a JSON editing interface.",
      "Don't turn uncertain opening targets into visually authoritative confirmed dates."
    ]
  }
}
