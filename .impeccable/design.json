      "css": ".ds-card{border:1px solid #e0dbd2;border-radius:21px;background:white;overflow:hidden;color:#123638;font-family:Inter,sans-serif}.ds-card-body{padding:25px 28px 18px}.ds-status{font-size:11px;color:#49716c;margin:0 0 8px}.ds-card h3{font:400 clamp(25px,2.15vw,34px)/1.17 \"Playfair Display\",Georgia,serif;letter-spacing:-.025em;margin:0 0 10px}.ds-highlights{font-size:14px;line-height:1.7;color:#415e60;margin:0 0 18px}.ds-source{display:block;border-top:1px solid #eee8df;padding-top:12px;color:#216668;font-size:11px;font-weight:600;text-decoration:none}.ds-source small{display:block;color:#526e70;font-size:10px;font-weight:400;line-height:1.6;overflow-wrap:anywhere;margin-top:4px}.ds-source:hover{text-decoration:underline}.ds-source:focus-visible{outline:3px solid #b89b53;outline-offset:5px}",
